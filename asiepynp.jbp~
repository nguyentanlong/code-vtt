using System;
using System.Collections.Generic;
using System.Data;
using System.Web;
using System.Web.Services;
using log4net;
using VTT.libs;

namespace VTT
{
    public partial class login : System.Web.UI.Page
    {
        private static readonly ILog log = LogManager.GetLogger(typeof(login));

        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack && Session["TaiKhoanID"] != null)
            {
                Response.Redirect("~/index.aspx");
            }
        }

        public class LoginResponse
        {
            public bool Success { get; set; }
            public string Message { get; set; }
            public string RedirectUrl { get; set; }
        }

        /// <summary>
        /// Hàm lấy IP Client (xử lý cả trường hợp đi qua Cloudflare / Proxy)
        /// </summary>
        private static string GetClientIP()
        {
            string ip = HttpContext.Current.Request.ServerVariables["HTTP_CF_CONNECTING_IP"];
            if (string.IsNullOrEmpty(ip))
                ip = HttpContext.Current.Request.ServerVariables["HTTP_X_FORWARDED_FOR"];
            if (string.IsNullOrEmpty(ip))
                ip = HttpContext.Current.Request.UserHostAddress;
            return ip ?? "127.0.0.1";
        }

        [WebMethod(EnableSession = true)]
        public static LoginResponse XuLyDangNhap(string username, string password)
        {
            LoginResponse res = new LoginResponse();
            ConnectServer db = new ConnectServer();

            try
            {
                string clientIP = GetClientIP();

                // Chuẩn bị tham số gọi SP
                Dictionary<string, object> parameters = new Dictionary<string, object>
                {
                    { "@Username", username },
                    { "@Password", password },
                    { "@IPAddress", clientIP }
                };

                // Gọi Stored Procedure
                DataSet ds = db.ExecuteDatasetStoredProcedure("dbo.sp_TaiKhoan_DangNhap", parameters);

                if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
                {
                    DataRow row = ds.Tables[0].Rows[0];
                    bool isSuccess = Convert.ToInt32(row["Success"]) == 1;
                    string message = row["Message"].ToString();

                    if (isSuccess)
                    {
                        // Lưu thông tin vào Session
                        HttpContext.Current.Session["TaiKhoanID"] = row["TaiKhoanID"];
                        HttpContext.Current.Session["Username"] = row["Username"];
                        HttpContext.Current.Session["NhanVienID"] = row["NhanVienID"];
                        HttpContext.Current.Session["HoTen"] = row["HoTen"];
                        HttpContext.Current.Session["EmailCongTy"] = row["EmailCongTy"];
                        HttpContext.Current.Session["CongTyID"] = row["CongTyID"];
                        HttpContext.Current.Session["PhongBanID"] = row["PhongBanID"];
                        HttpContext.Current.Session["ChucDanhID"] = row["ChucDanhID"];

                        res.Success = true;
                        res.Message = message;
                        res.RedirectUrl = "index.aspx";
                    }
                    else
                    {
                        res.Success = false;
                        res.Message = message;
                    }
                }
                else
                {
                    res.Success = false;
                    res.Message = "Không nhận được phản hồi từ hệ thống Database!";
                }
            }
            catch (Exception ex)
            {
                log.Error("Lỗi trong XuLyDangNhap WebMethod: ", ex);
                res.Success = false;
                res.Message = "Đã xảy ra lỗi hệ thống: " + ex.Message;
            }

            return res;
        }
    }
}