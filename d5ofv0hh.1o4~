using System;
using System.Collections.Generic;
using System.Data;
using System.Web;
using System.Web.Services;
using log4net;
using VTT.libs;

namespace VTT
{
    public partial class login : System.Web.UI.Page
    {
        private static readonly ILog log = LogManager.GetLogger(typeof(login));

        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack && Session["TaiKhoanID"] != null)
            {
                Response.Redirect("~/login.aspx");
            }
        }

        public class LoginResponse
        {
            public bool Success { get; set; }
            public string Message { get; set; }
            public string RedirectUrl { get; set; }
        }

        /// <summary>
        /// Hàm lấy IP Client (xử lý cả trường hợp đi qua Cloudflare / Proxy)
        /// </summary>
        private static string GetClientIP()
        {
            string ip = HttpContext.Current.Request.ServerVariables["HTTP_CF_CONNECTING_IP"];
            if (string.IsNullOrEmpty(ip))
                ip = HttpContext.Current.Request.ServerVariables["HTTP_X_FORWARDED_FOR"];
            if (string.IsNullOrEmpty(ip))
                ip = HttpContext.Current.Request.UserHostAddress;
            return ip ?? "127.0.0.1";
        }

        [WebMethod(EnableSession = true)]
        public static LoginResponse XuLyDangNhap(string username, string password)
        {
            LoginResponse res = new LoginResponse();
            ConnectServer db = new ConnectServer();

            try
            {
                string clientIP = GetClientIP();

                Dictionary<string, object> parameters = new Dictionary<string, object>
        {
            { "@Username", username },
            { "@IPAddress", clientIP }
        };

                DataSet ds = db.ExecuteDatasetStoredProcedure("dbo.sp_chinh_TaiKhoan_DangNhap", parameters);

                if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
                {
                    DataRow row = ds.Tables[0].Rows[0];
                    bool isSuccess = Convert.ToInt32(row["Success"]) == 1;
                    string message = row["Message"].ToString();

                    // Nếu IP đang bị chặn
                    if (!isSuccess)
                    {
                        res.Success = false;
                        res.Message = message;
                        return res;
                    }

                    // Kiểm tra trạng thái khóa tài khoản
                    bool isLocked = row["IsLocked"] != DBNull.Value && Convert.ToBoolean(row["IsLocked"]);
                    byte trangThai = row["TrangThaiTK"] != DBNull.Value ? Convert.ToByte(row["TrangThaiTK"]) : (byte)0;

                    if (isLocked || trangThai == 0)
                    {
                        res.Success = false;
                        res.Message = "Tài khoản của bạn đang bị khóa hoặc ngưng hoạt động!";
                        return res;
                    }

                    // --- KIỂM TRA MẬT KHẨU MÃ HÓA ---
                    string dbPasswordHash = row["PasswordHash"].ToString();
                    bool isPasswordValid = libs.libs.VerifyPassword(password, dbPasswordHash);

                    if (!isPasswordValid)
                    {
                        // Ghi log thất bại vào NhatKyHeThong để tính lượt khóa IP
                        string logFailedSql = string.Format(
                            "INSERT INTO dbo.NhatKyHeThong (LoaiLog, NoiDung, NguoiThucHienID, IP, ThoiGian) VALUES ('LOGIN_FAILED', N'Đăng nhập thất bại: Sai mật khẩu [{0}]', {1}, '{2}', SYSUTCDATETIME())",
                            username, row["NhanVienID"] != DBNull.Value ? row["NhanVienID"] : "NULL", clientIP
                        );
                        db.SaveInfo(logFailedSql);

                        res.Success = false;
                        res.Message = "Tên đăng nhập hoặc mật khẩu không chính xác!";
                        return res;
                    }

                    // ĐĂNG NHẬP THÀNH CÔNG
                    HttpContext.Current.Session["TaiKhoanID"] = row["TaiKhoanID"];
                    HttpContext.Current.Session["Username"] = row["Username"];
                    HttpContext.Current.Session["NhanVienID"] = row["NhanVienID"];
                    HttpContext.Current.Session["HoTen"] = row["HoTen"];
                    HttpContext.Current.Session["EmailCongTy"] = row["EmailCongTy"];
                    HttpContext.Current.Session["CongTyID"] = row["CongTyID"];
                    HttpContext.Current.Session["PhongBanID"] = row["PhongBanID"];
                    HttpContext.Current.Session["ChucDanhID"] = row["ChucDanhID"];

                    // Update LastLogin & Log Success
                    string updateSuccessSql = string.Format(
                        "UPDATE dbo.DMTaiKhoan SET LastLogin = SYSUTCDATETIME() WHERE TaiKhoanID = {0}; " +
                        "INSERT INTO dbo.NhatKyHeThong (LoaiLog, NoiDung, NguoiThucHienID, IP, ThoiGian) VALUES ('LOGIN_SUCCESS', N'Đăng nhập thành công', {1}, '{2}', SYSUTCDATETIME());",
                        row["TaiKhoanID"], row["NhanVienID"] != DBNull.Value ? row["NhanVienID"] : "NULL", clientIP
                    );
                    db.SaveInfo(updateSuccessSql);

                    res.Success = true;
                    res.Message = "Đăng nhập thành công!";
                    res.RedirectUrl = "index.aspx";
                }
                else
                {
                    // Tên đăng nhập không tồn tại
                    string logFailedSql = string.Format(
                        "INSERT INTO dbo.NhatKyHeThong (LoaiLog, NoiDung, IP, ThoiGian) VALUES ('LOGIN_FAILED', N'Đăng nhập thất bại: Khong ton tai user [{0}]', '{1}', SYSUTCDATETIME())",
                        username, clientIP
                    );
                    db.SaveInfo(logFailedSql);

                    res.Success = false;
                    res.Message = "Tên đăng nhập hoặc mật khẩu không chính xác!";
                }
            }
            catch (Exception ex)
            {
                log.Error("Lỗi trong XuLyDangNhap WebMethod: ", ex);
                res.Success = false;
                res.Message = "Đã xảy ra lỗi hệ thống: " + ex.Message;
            }

            return res;
        }
    }
}